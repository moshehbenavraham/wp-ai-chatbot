# JS: Biome format + lint via lint-staged
npx lint-staged

# PHP: Format staged PHP files via Docker (PHP-CS-Fixer)
STAGED_PHP=$(git diff --cached --name-only --diff-filter=ACMR -- '*.php')
if [ -n "$STAGED_PHP" ]; then
  if command -v docker >/dev/null 2>&1; then
    echo "Running PHP-CS-Fixer on staged PHP files..."
    # shellcheck disable=SC2086
    docker run --rm -v "$(pwd):/app" -w /app php:8.3-cli \
      vendor/bin/php-cs-fixer fix --config=.php-cs-fixer.dist.php \
      --path-mode=intersection $STAGED_PHP
    # Re-stage formatted files
    # shellcheck disable=SC2086
    git add $STAGED_PHP
  else
    echo "Warning: Docker not available, skipping PHP formatting"
  fi
fi
